{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "rclone",
          "cmd": "rclone",
          "args": [
            { "validator": "^(copy|sync|check|ls|lsd|lsf|obscure|--version)$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" }
          ]
        },
        {
          "name": "binaries/rclone-sidecar",
          "sidecar": true,
          "args": [
            { "validator": "^(copy|sync|check|ls|lsd|lsf|obscure|--version)$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "rclone",
          "cmd": "rclone",
          "args": [
            { "validator": "^(copy|sync|check|ls|lsd|lsf|obscure|--version)$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" }
          ]
        },
        {
          "name": "binaries/rclone-sidecar",
          "sidecar": true,
          "args": [
            { "validator": "^(copy|sync|check|ls|lsd|lsf|obscure|--version)$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" },
            { "validator": "^[^\\x00-\\x1F]+$" }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "rclone",
          "cmd": "rclone"
        },
        {
          "name": "binaries/rclone-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
