{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scs-rclient",
  "version": "0.1.0",
  "identifier": "online.anthonyis.scs-rclient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scs-rclient",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost wss://ipc.localhost tauri: https: http:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Anthony",
    "shortDescription": "SCS Rclone Client",
    "copyright": "see license",
    "category": "Utility",
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NTY0MzIwM0MxNDIyQkUKUldTK0loUThJRU5XOWNTa2FZbnBtZmtTRVRET2RtZUp4eXBCRkRxQUgwWnRObHEwTGxpSkI1R1gK",
      "endpoints": [
        "https://github.com/anthony1x6000/scs-rclient/releases/latest/download/latest.json"
      ]
    }
  }
}
